{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  // NOTE: model
  "model": "zai-coding-plan/glm-5.1",
  "small_model": "zai-coding-plan/glm-5-turbo",
  "default_agent": "plan",
  // NOTE: merged with AGENTS.md, support https://
  "instructions": ["CONTRIBUTING.md", "docs/*.md"],

  // NOTE: permissions (default allow)
  "permission": {
    "bash": "ask",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "read": "allow",
    "webfetch": "allow"
  },

  // NOTE: local models
  "disabled_providers": ["openai"],
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "local",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "ministral-3:3b-instruct-2512-q4_K_M": {
          "name": "ministral3"
        }
      }
    }
  },

  // NOTE: MCP
  "mcp": {
    "godoc": {
      "type": "local",
      "command": [
        "godoc-mcp",
        "-transport=stdio"
      ],
      "environment": {}
    },
    "gopls": {
      "type": "local",
      "command": [
        "gopls",
        "mcp"
      ],
      "environment": {}
    },
    "github": {
      "type": "local",
      "command": [
        "github-mcp-server",
        "stdio",
        "--read-only"
      ],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env GITHUB_API_KEY}",
        "GITHUB_LOCKDOWN_MODE": "0"
      }
    },
    "terraform": {
      "type": "local",
      "command": [
        "terraform-mcp-server",
        "stdio"
      ],
      "environment": {
        "ENABLE_TF_OPERATIONS": "false",
        "TFE_ADDRESS": ""
      }
    },
    "opentofu": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.opentofu.org/mcp"
    },
    "aws-knowledge-mcp-server": {
      "enabled": true,
      "type": "remote",
      "url": "https://knowledge-mcp.global.api.aws"
    },
    "aws-documentation-mcp-server": {
      "enabled": true,
      "type": "local",
      "command": [
        "uvx",
        "awslabs.aws-documentation-mcp-server@latest"
      ],
      "environment": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    },
    "deepwiki": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.deepwiki.com/mcp"
    },
    "web-search-prime": {
      "enabled": false,
      "type": "remote",
      "url": "https://api.z.ai/api/mcp/web_search_prime/mcp",
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:ZAI_API_KEY}"
      }
    },
    "web-reader": {
      "enabled": false,
      "type": "remote",
      "url": "https://api.z.ai/api/mcp/web_reader/mcp",
      "headers": {
        "Authorization": "Bearer {env:ZAI_API_KEY}"
      }
    }
  }
}
